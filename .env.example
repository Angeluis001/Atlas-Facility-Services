# Copia a .env.local para desarrollo con `vercel dev`
# En producción: Vercel → Project → Settings → Environment Variables

# Connection string de Neon (Dashboard → Connection Details → pooled / serverless)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Panel admin — firma de cookies de sesión (mín. 16 caracteres, aleatorio)
ADMIN_SESSION_SECRET=genera-un-string-largo-aleatorio

# Solo para scripts/seed-admin.mjs (no hace falta en Vercel runtime)
# ADMIN_EMAIL=angeluis012@hotmail.com
# ADMIN_PASSWORD=tu-password-seguro
# ADMIN_NAME=Angel
